    "NSCalendarsUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskfocus shows today's events so you can focus on them."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskfocus mostra gli eventi di oggi per aiutarti a concentrarti."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
