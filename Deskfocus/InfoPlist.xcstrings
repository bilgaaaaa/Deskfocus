    "NSRemindersUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskfocus shows today's reminders and marks them done when you finish."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskfocus mostra i promemoria di oggi e li segna come completati quando hai finito."
          }
        }
      }
    },
