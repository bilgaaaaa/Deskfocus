// Shared build settings. Personal values live in Secrets.xcconfig, which is git-ignored.

// Apple Developer Team ID, needed for signing and the App Group shared with the widget.
DESKFOCUS_TEAM_ID =

// Google OAuth client id of type "iOS" (e.g. 1234-abcd.apps.googleusercontent.com).
GOOGLE_CLIENT_ID =

// Google blocks everyone but its test users until it verifies the app, so public (Release) builds show
// "Coming soon" instead of Connect. Debug builds keep it on; set YES here once Google has approved Deskfocus.
GOOGLE_SYNC_ENABLED = NO
GOOGLE_SYNC_ENABLED[config=Debug] = YES

#include? "Secrets.xcconfig"
